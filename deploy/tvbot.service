[Unit]
Description=tvbot - paper trading bot (44 estrategias validadas)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=opc
WorkingDirectory=/opt/tvbot
ExecStart=/opt/tvbot/.venv/bin/python -m tvbot
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1
Environment=TZ=America/Lima

[Install]
WantedBy=multi-user.target
